# FileVela Production & Development Environment Configuration
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0

# Domain & Canonical URL (Production: https://filevela.biz.id)
NEXT_PUBLIC_SITE_DOMAIN=filevela.biz.id
NEXT_PUBLIC_SITE_URL=https://filevela.biz.id

# Disable Next.js Telemetry in Production
NEXT_TELEMETRY_DISABLED=1

# Storage Directory (Default: .storage inside project root)
STORAGE_DIR=.storage

# Retention TTL in Minutes (Default: 60)
RETENTION_TTL_MINUTES=60

# Maximum Upload File Size in MB (Default: 50)
MAX_FILE_SIZE_MB=50

# Optional Binary Path Overrides for Linux / cPanel Hosting
# (Leave blank to auto-detect from ~/bin, ~/.local/bin, /usr/local/bin, or system PATH)
FFMPEG_PATH=
FFPROBE_PATH=
YTDLP_PATH=
PYTHON_PATH=
LIBREOFFICE_PATH=

# Background Removal Cloud AI Key (Optional - local Sharp CIE-Lab provider is used if unset)
BG_REMOVAL_API_KEY=
